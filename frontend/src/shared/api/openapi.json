            "description": "Cost of being short divided by cost of being long",
            "title": "Cost Ratio",
            "type": "number"
          },
          "covered_share": {
            "description": "Share of scored hours the buffer would have covered",
            "title": "Covered Share",
            "type": "number"
          },
          "quantile": {
            "description": "q* = ratio / (ratio + 1)",
            "title": "Quantile",
            "type": "number"
          }
        },
        "required": [
          "cost_ratio",
          "quantile",
          "buffer_mw",
          "covered_share"
        ],
