        "title": "AccuracySummary",
        "type": "object"
      },
      "BufferOption": {
        "properties": {
          "buffer_mw": {
            "description": "Cover to hold: the q*-quantile of the errors",
            "title": "Buffer Mw",
            "type": "number"
