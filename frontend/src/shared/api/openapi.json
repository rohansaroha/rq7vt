  "info": {
    "description": "UK national wind generation: the forecast available at decision time and how accurate such forecasts were. Data: Elexon FUELHH and WINDFOR.",
    "title": "Wind Forecast Portal API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/accuracy/lead-time": {
      "get": {
        "operationId": "lead_time_api_v1_accuracy_lead_time_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeadTimeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid parameters"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unexpected error"
          }
        },
        "summary": "How the error grows with lead time, overall and by hour of day",
        "tags": [
          "accuracy"
        ]
      }
    },
    "/api/v1/accuracy/summary": {
      "get": {
        "operationId": "summary_api_v1_accuracy_summary_get",
        "parameters": [
          {
            "description": "gate: score the run available at the gate. horizon: score the latest run published at least horizon_h hours before each hour.",
            "in": "query",
            "name": "mode",
            "required": false,
            "schema": {
              "default": "gate",
              "description": "gate: score the run available at the gate. horizon: score the latest run published at least horizon_h hours before each hour.",
              "enum": [
                "gate",
                "horizon"
              ],
              "title": "Mode",
              "type": "string"
            }
          },
          {
            "description": "Gate closure in UK time (HH:MM) on the day before delivery.",
            "in": "query",
            "name": "gate",
            "required": false,
            "schema": {
              "default": "09:20",
              "description": "Gate closure in UK time (HH:MM) on the day before delivery.",
              "examples": [
                "09:20"
              ],
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
              "title": "Gate",
              "type": "string"
            }
          },
          {
            "description": "Hours ahead, used when mode=horizon.",
            "in": "query",
            "name": "horizon_h",
            "required": false,
            "schema": {
              "default": 24,
              "description": "Hours ahead, used when mode=horizon.",
              "maximum": 48,
              "minimum": 0,
              "title": "Horizon H",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccuracySummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid parameters"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unexpected error"
          }
        },
        "summary": "Accuracy over the analysis period, the error distribution and buffer sizes",
        "tags": [
          "accuracy"
        ]
      }
    },
    "/api/v1/forecasts/decision": {
      "get": {
        "operationId": "decision_api_v1_forecasts_decision_get",
        "parameters": [
          {
            "description": "Delivery day (YYYY-MM-DD). It runs from 23:00 UK time the evening before.",
            "in": "query",
            "name": "day",
            "required": true,
            "schema": {
              "description": "Delivery day (YYYY-MM-DD). It runs from 23:00 UK time the evening before.",
              "examples": [
                "2026-01-14"
              ],
              "format": "date",
              "title": "Day",
              "type": "string"
            }
          },
          {
            "description": "Gate closure in UK time (HH:MM) on the day before delivery.",
            "in": "query",
            "name": "gate",
            "required": false,
            "schema": {
              "default": "09:20",
              "description": "Gate closure in UK time (HH:MM) on the day before delivery.",
              "examples": [
                "09:20"
              ],
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
              "title": "Gate",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid parameters"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unexpected error"
          }
        },
        "summary": "The forecast available at the gate for one delivery day, against the actuals",
        "tags": [
          "forecasts"
        ]
      }
    },
    "/api/v1/forecasts/runs": {
      "get": {
        "operationId": "runs_api_v1_forecasts_runs_get",
