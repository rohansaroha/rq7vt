# Local settings. `make setup` copies this file to backend/.env.
#
# Docker Postgres from `make db` (on port 54320, so it never clashes with another Postgres).
# Using a Postgres you already run instead? `make local-db` rewrites these two lines.
# postgres://... URLs, as Neon and Vercel give them, work too.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:54320/wind
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:54320/wind_test

# Optional (defaults shown)
# ENVIRONMENT=local
# CORS_ORIGINS=["http://localhost:5173"]
# LOG_LEVEL=INFO
# LOG_JSON=false
# DB_NULL_POOL=false        # no pool, no prepared statements; on by default on Vercel
# ELEXON_MAX_CONCURRENCY=4
